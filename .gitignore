# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Phase 2: graph-sequence dataset cache (regenerable via
# scripts/build_graph_dataset.py from the raw CSVs + code)
data/processed/

# Datasets (large, fetched separately per README instructions)
data/cicids2017/**/*.csv
data/cicids2018/*.csv
data/cicids2018-pcap/**/*.pcap
data/ctu13/**/*.pcap
data/ctu13/**/*.csv
data/*.DS_Store
!data/**/.gitkeep

# Model artifacts / checkpoints (Phase 3+) -- regenerable via
# models/train.py + configs/training.yaml + the fixed seed
checkpoints/*
*.pt
*.pth
*.ckpt
# Exception: the small (<1MB) shipped model, required by the Docker deployment
!checkpoints/phase3/
!checkpoints/phase3/*

# OS / editor
.DS_Store
.vscode/
.idea/

# Test / cache
.pytest_cache/
.coverage


